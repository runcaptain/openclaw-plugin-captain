{
  "id": "captain",
  "name": "Captain",
  "description": "Multimodal search across text, images, video, and audio using Captain's RAG API. Search private knowledge bases with natural language.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Captain API key (starts with cap_)"
      },
      "organizationId": {
        "type": "string",
        "description": "Captain organization ID"
      },
      "baseUrl": {
        "type": "string",
        "description": "Captain API base URL",
        "default": "https://api.runcaptain.com"
      }
    },
    "required": ["apiKey", "organizationId"]
  },
  "uiHints": {
    "apiKey": {
      "label": "Captain API Key",
      "help": "Get your API key at runcaptain.com/studio",
      "placeholder": "cap_...",
      "sensitive": true
    },
    "organizationId": {
      "label": "Organization ID",
      "help": "Your Captain organization ID",
      "placeholder": "019a..."
    },
    "baseUrl": {
      "label": "API Base URL",
      "help": "Override for self-hosted Captain instances",
      "placeholder": "https://api.runcaptain.com",
      "advanced": true
    }
  },
  "activation": {
    "onCapabilities": ["tool"]
  },
  "contracts": {
    "tools": ["captain_search", "captain_list_collections", "captain_index_url", "captain_index_youtube", "captain_index_text", "captain_index_s3", "captain_index_gcs", "captain_index_azure", "captain_index_r2"]
  }
}
